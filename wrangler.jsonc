{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sellerai",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sellerai-db",
      "database_id": "7a3208cf-151b-4800-b9aa-9be9971bf655"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "sellerai-images"
    }
  ],
  "ai": { "binding": "AI" }
}
